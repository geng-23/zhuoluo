# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.svn/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# 发布签名密钥与凭据（不入库）
/android/key.properties
/android/app/*.keystore
*.jks
*.p12
*.pfx
*.pem

# 本机环境路径（SDK/Flutter 位置，不入库）
local.properties

# 内部审查文档（着落项目总览/备份方案设计，不公开）
docs/

# Kotlin 编译缓存
android/.kotlin/

# Gradle 构建缓存
android/.gradle/

# Flutter 本机生成文件（不入库）
.metadata
devtools_options.yaml

# 隐私文件
AGENTS.md

# dsh 会话缓存与工具产物（不入库）
# .dsh_cache  可复用缓存（Flutter SDK 副本 / Gradle 缓存 / pub-cache），保留不删
# .dsh_tmp    一次性产物（截图、UI dump、临时 sqlite），运行完成后清理
# .dsh-vision-router  视觉工具产物（自动重建）
.dsh_cache/
.dsh_tmp/
.dsh-vision-router/

